# Prisma / Hostinger MySQL. Names and placeholders only — never commit secrets.
#
# Runtime URL for the Next.js app on Vercel (Node serverless). Must be mysql://,
# not prisma://. connection_limit=1 keeps each function instance to one MySQL
# connection so shared-host limits are not exhausted. pool_timeout is seconds
# to wait for a free pooled connection (Prisma default is 10).
#
# Hostinger remote MySQL may require SSL. Prisma's default is
# sslaccept=accept_invalid_certs; use sslaccept=strict when the server presents
# a trusted certificate. Example:
# mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=1&pool_timeout=20&sslaccept=strict

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=1&pool_timeout=20&sslaccept=strict"

# Direct URL for Prisma Migrate / introspection. Keep this even when DATABASE_URL
# is already a mysql:// URL.
DIRECT_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict"

# Shadow database for `prisma migrate` (local/CI migrate workflows).
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/SHADOW_DATABASE?sslaccept=strict"
